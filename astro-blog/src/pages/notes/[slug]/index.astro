---
import Base from '../../../layouts/Base.astro';
import CodexStatus from '../../../components/react/CodexStatus.jsx';
import { posts, url, dot, legacyHtml, bodyHtml, type Post } from '../../../lib/posts';

export function getStaticPaths() {
  return posts.map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Post };
let main = '', toc: [string, string][] = [], body = '';
if (p.kind === 'hub') main = '<main id="main" class="page guide-home">' + legacyHtml(p.slug) + '</main>';
else if (p.kind === 'chapter') main = legacyHtml(p.slug);
else {
  body = bodyHtml(p);
  toc = [...body.matchAll(/<section id="([^"]+)"><h2>(.*?)<\/h2>/g)].map(m => [m[1], m[2]]);
}
const i = posts.indexOf(p);
const next = posts.filter(x => x.kind !== 'chapter' && x.slug !== p.slug)[0];
---
<Base title={p.title} path={url(p)} description={p.description} post={p}>
  {main ? <Fragment set:html={main} /> : (
    <main id="main" class="page article-page new-article">
      <a class="back" href="/archive/">← 全部文章</a>
      <header class="post-header" data-reveal>
        <p class="eyebrow">FIELD NOTES <span> / </span> {p.category}</p>
        <h1>{p.title}</h1>
        <p class="subtitle">{p.subtitle}</p>
        <div class="meta"><time datetime={p.date}>{dot(p.date)}</time><span>文 / ATIPIU</span><span>{p.minutes} 分钟阅读</span></div>
      </header>
      {p.slug === 'codex-reset-watch' && <CodexStatus client:visible />}
      <div class="article-layout">
        <aside class="article-rail"><details class="article-toc" open><summary>本篇目录 <span>↗</span></summary><nav aria-label="文章目录">{toc.map(([a, t], n) => <a href={'#' + a}><span>{String(n + 1).padStart(2, '0')}</span><Fragment set:html={t} /></a>)}</nav></details></aside>
        <article class="prose" set:html={body} />
      </div>
      {next && <a class="next-post" href={url(next)} data-reveal><span>下一篇</span><strong>{next.title}</strong><em>{next.description}</em><i aria-hidden="true">→</i></a>}
      <div class="post-bottom"><a href="/archive/">← 全部文章</a><button class="plain-button" type="button" data-share>复制文章链接 ↗</button></div>
    </main>
  )}
</Base>
